generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  value         Float
  originalValue Float
  stock         Int
  unit          String
  origin        String
  description   String
  urlImage      String
  categorieId   Int
  category      Category @relation(fields: [categorieId], references: [id])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  product     Product[]
}
